generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  telegramId        String   @unique
  telegramUsername  String?
  firstName         String
  lastName          String?
  middleName        String?
  birthDate         DateTime?
  passportEncrypted String?
  passportIv        String?
  passportTag       String?
  phone             String?
  email             String?
  country           String   @default("AM")
  role              String   @default("USER")
  isVerified        Boolean  @default(false)
  isBlocked         Boolean  @default(false)
  fraudScore        Int      @default(0)
  deviceFingerprint String?
  registrationIp    String?
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  participations    AuctionParticipant[]
  purchases         Purchase[]
  payments          Payment[]
  notifications     Notification[]
  settings          UserSettings?

  @@index([telegramId])
  @@index([isBlocked])
  @@index([country])
}

model UserSettings {
  id                String  @id @default(uuid())
  userId            String  @unique
  language          String  @default("ru")
  pushEnabled       Boolean @default(true)
  emailEnabled      Boolean @default(false)
  smsEnabled        Boolean @default(false)
  telegramEnabled   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(uuid())
  name      String
  icon      String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  auctions  Auction[]
}

model Auction {
  id                String   @id @default(uuid())
  title             String
  description       String?
  categoryId        String?
  organizerId       String?
  marketPrice       Float    @default(0)
  participationFee  Float    @default(0)
  startPrice        Float    @default(0)
  currentPrice      Float    @default(0)
  minPrice          Float    @default(0)
  priceDropInterval Int      @default(60)
  priceDropAmount   Float    @default(0)
  status            String   @default("DRAFT")
  country           String   @default("AM")
  maxParticipants   Int?
  scheduledStart    DateTime?
  actualStart       DateTime?
  endTime           DateTime?
  winnerId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category          Category?     @relation(fields: [categoryId], references: [id])
  images            AuctionImage[]
  videos            AuctionVideo[]
  participations    AuctionParticipant[]
  purchases         Purchase[]
  priceHistory      PriceHistory[]

  @@index([status])
  @@index([country])
  @@index([categoryId])
  @@index([createdAt])
}

model AuctionImage {
  id        String  @id @default(uuid())
  auctionId String
  url       String
  order     Int     @default(0)

  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
}

model AuctionVideo {
  id        String  @id @default(uuid())
  auctionId String
  url       String

  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
}

model AuctionParticipant {
  id        String   @id @default(uuid())
  auctionId String
  userId    String
  status    String   @default("PENDING")
  paymentId String?
  joinedAt  DateTime @default(now())
  refundedAt DateTime?

  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([auctionId, userId])
  @@index([userId])
}

model Purchase {
  id            String   @id @default(uuid())
  auctionId     String
  userId        String
  purchasePrice Float    @default(0)
  status        String   @default("PENDING")
  providerTxId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auction       Auction  @relation(fields: [auctionId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([auctionId])
  @@index([userId])
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  amount        Float    @default(0)
  currency      String   @default("AMD")
  provider      String
  type          String
  status        String   @default("PENDING")
  providerTxId  String?
  metadata      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model PriceHistory {
  id        String   @id @default(uuid())
  auctionId String
  price     Float    @default(0)
  timestamp DateTime @default(now())

  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, timestamp])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  data      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model AuthPin {
  id          String   @id @default(uuid())
  pin         String   @unique
  telegramId  String
  firstName   String
  lastName    String?
  username    String?
  used        Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([pin])
  @@index([expiresAt])
}
